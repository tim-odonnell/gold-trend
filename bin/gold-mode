#!/bin/bash
# gold-mode - switch the gold trend report between manual (Run Now icon only) and nightly automatic runs.
# Usage: gold-mode manual | nightly | status
set -u
MODE_FILE="$HOME/.config/gold-trend/run-mode"
mkdir -p "$(dirname "$MODE_FILE")"
case "${1:-}" in
    manual)
        systemctl --user disable --now gold-report.timer
        echo manual > "$MODE_FILE"
        notify-send -a "Gold trend" -i media-playback-pause "Gold report: MANUAL mode" "It runs only when you double-click Gold Report - Run Now."
        ;;
    nightly)
        systemctl --user daemon-reload
        systemctl --user enable --now gold-report.timer
        echo nightly > "$MODE_FILE"
        next=$(systemctl --user show gold-report.timer -p NextElapseUSecRealtime --value)
        notify-send -a "Gold trend" -i appointment-soon "Gold report: NIGHTLY mode" "Runs automatically Mon-Fri at 06:30. Next: ${next:-?}"
        ;;
    status)
        echo "Mode: $(cat "$MODE_FILE" 2>/dev/null || echo 'not set (manual)')"
        echo "Timer: $(systemctl --user is-enabled gold-report.timer 2>/dev/null)"
        systemctl --user list-timers gold-report.timer --no-pager | sed -n 1,2p
        echo "Last run: $(journalctl --user -u gold-report.service -o short-iso --no-pager 2>/dev/null | grep -E 'Finished|Failed' | tail -1 | cut -c1-19)"
        ls -1t "$HOME/Gold-Reports"/*.html 2>/dev/null | grep -v latest | head -1 | sed 's/^/Newest report: /'
        ;;
    *)
        echo "Usage: gold-mode manual | nightly | status" >&2
        exit 1
        ;;
esac
